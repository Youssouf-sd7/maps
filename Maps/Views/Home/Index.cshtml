@model List<Maps.Models.SpeciesOccurrence>
@{
    ViewData["Title"] = "Distribution des especes";
    var choices = ViewBag.Choices as List<ProfessorChoice> ?? new List<ProfessorChoice>();
    int index = 1;
}

<div class="container-fluid px-4 py-5" style="max-width: 1400px;">
    <!-- En-tête Institutionnel -->
    <div class="d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-semibold text-dark mb-1">Cartes de distribution</h1>
            @* <p class="text-secondary mb-0 small">Examinez les cartes, sélectionnez le seuil optimal et formulez vos observations.</p> *@
        </div>
        <div class="d-flex gap-2">
            <a asp-action="DownloadSelected" class="btn btn-dark btn-sm px-3 d-flex align-items-center gap-2">
                <i class="bi bi-download"></i> Télécharger
            </a>
            <a asp-action="Logout" class="btn btn-outline-secondary btn-sm px-3">Déconnexion</a>
        </div>
    </div>

    <!-- Tableau Professionnel -->
    <div class="card border shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                    <thead class="table-light text-uppercase fs-7 text-secondary border-bottom">
                        <tr>
                            <th class="py-3 ps-4" style="width: 60px;">#</th>
                            <th class="py-3">Nom</th>
                            <th class="py-3">Occurrences</th>
                            <th class="py-3">Seuil validé</th>
                            <th class="py-3">Commentaire</th>
                            <th class="py-3 text-end pe-4" style="width: 150px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var choice = choices.Find(c => c.SpeciesName == item.Species);
                            var threshold = choice?.SelectedThreshold;
                            var comment = choice?.Comment;

                            <tr>
                                <td class="ps-4 text-muted fw-medium">@(index++)</td>
                                <td>
                                    <span class="fw-semibold fst-italic text-dark">@item.Species</span>
                                </td>
                                <td>
                                    <span class="text-secondary font-monospace">@item.UniqueOccurrences</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(threshold) || threshold == "none")
                                    {
                                        <span class="badge bg-light text-secondary border fw-normal px-2 py-1">Non défini</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-medium px-2 py-1">Seuil @threshold</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(comment))
                                    {
                                        <span class="text-success" data-bs-toggle="tooltip" data-bs-placement="top" title="@comment" style="cursor: pointer;">
                                            <i class="bi bi-chat-text-fill fs-5"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-name="@item.Species" class="btn btn-sm btn-outline-dark px-3 py-1">
                                        Évaluer
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>