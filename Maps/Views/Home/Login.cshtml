@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- CSS via unpkg -->
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
            body {
                background-color: #f8f9fa;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .login-card {
                max-width: 420px;
                width: 100%;
                border: 1px solid rgba(0, 0, 0, 0.08);
            }
    </style>
</head>
<body class="h-100 d-flex align-items-center justify-content-center">

    <div class="card login-card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">
        <div class="text-center mb-4">
            <div class="mb-3 text-dark">
                <i class="bi bi-shield-lock fs-1"></i>
            </div>
            <h2 class="h4 fw-bold text-dark mb-1">Connexion</h2>
            @* <p class="text-secondary small mb-0">Plateforme d'évaluation des cartes de distribution</p> *@
        </div>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                @* <label class="form-label text-secondary small fw-semibold text-uppercase">Code d'accès</label> *@
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" name="code" class="form-control bg-light border-start-0 ps-0 shadow-none" placeholder="Entrez le code secret..." required autofocus />
                </div>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-dark py-2 fw-medium">
                    Se connecter <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger text-center small py-2 mb-0 rounded-3">
                    <i class="bi bi-exclamation-circle me-1"></i> Code d'accès incorrect.
                </div>
            }
        </form>

@*         <div class="text-center mt-4">
            <span class="text-muted" style="font-size: 0.8rem;">Usage réservé à l'évaluation académique</span>
        </div> *@
    </div>

</body>
</html>